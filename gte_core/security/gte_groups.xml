<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_gte" model="ir.module.category">
        <field name="name">Green Tech Construction</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_gte_field" model="res.groups">
        <field name="name">Field Employee</field>
        <field name="category_id" ref="module_category_gte"/>
    </record>
    <record id="group_gte_foreman" model="res.groups">
        <field name="name">Site Foreman / Superintendent</field>
        <field name="category_id" ref="module_category_gte"/>
        <field name="implied_ids" eval="[(4, ref('group_gte_field'))]"/>
    </record>
    <record id="group_gte_estimator" model="res.groups">
        <field name="name">Estimator</field>
        <field name="category_id" ref="module_category_gte"/>
        <field name="implied_ids" eval="[(4, ref('group_gte_field'))]"/>
    </record>
    <record id="group_gte_safety" model="res.groups">
        <field name="name">Safety Lead</field>
        <field name="category_id" ref="module_category_gte"/>
        <field name="implied_ids" eval="[(4, ref('group_gte_field'))]"/>
    </record>
    <record id="group_gte_coordinator" model="res.groups">
        <field name="name">Project Coordinator</field>
        <field name="category_id" ref="module_category_gte"/>
        <field name="implied_ids" eval="[(4, ref('group_gte_field'))]"/>
    </record>
    <record id="group_gte_accounting" model="res.groups">
        <field name="name">Accounting / Project Controls</field>
        <field name="category_id" ref="module_category_gte"/>
    </record>
    <record id="group_gte_pm" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="category_id" ref="module_category_gte"/>
        <field name="implied_ids" eval="[(4, ref('group_gte_coordinator'))]"/>
    </record>
    <record id="group_gte_admin" model="res.groups">
        <field name="name">Construction Administrator</field>
        <field name="category_id" ref="module_category_gte"/>
        <field name="implied_ids" eval="[(4, ref('group_gte_pm')), (4, ref('group_gte_accounting')), (4, ref('group_gte_safety'))]"/>
    </record>
</odoo>
