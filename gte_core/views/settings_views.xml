<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_gte" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.gte</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Construction" name="gte_construction">
                    <block title="Approvals">
                        <setting string="Change order approval limit" help="Approvals above this amount require a Construction Administrator. 0 disables.">
                            <field name="gte_co_approval_limit"/>
                        </setting>
                    </block>
                    <block title="Reminders">
                        <setting string="RFI reminder lead (days)">
                            <field name="gte_rfi_reminder_days"/>
                        </setting>
                        <setting string="Submittal reminder lead (days)">
                            <field name="gte_submittal_reminder_days"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
