                         <group>
                             <group>
                                 <field name="quickbook_id"/>
                                 <field name="quickbook_purchase_order_name"/>
                                 <field name="sync_to_quickbook" widget="boolean_toggle"/>
                             </group>
                             <group>
                                 <field name="instance_name"/>
                                 <field name="quickbook_sync_token"/>
                                 <field name="odoo_hash"/>
                             </group>
                         </group>
                     </page>
                </xpath>
                 <xpath expr="//div[@name='button_box']" position="inside">
                     <button name="purchase_order_send_to_quickbook"  class="oe_stat_button oe_highlight" icon="fa-refresh"  string='SYNC TO QUICKBOOK' type="object"/>
                </xpath>
            </field>
        </record>

        <record id="view_purchase_order_tree_inherit" model="ir.ui.view">
            <field name="name">purchase.order.list</field>
            <field name="model">purchase.order</field>
            <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
            <field name="arch" type="xml">
                <xpath expr="field[@name='name']" position="after">
                    <field name="quickbook_id" optional="show"/>
                    <field name="quickbook_purchase_order_name" optional="show"/>
                    <field name="sync_to_quickbook" optional="show" widget="boolean_toggle"/>
                    <field name="odoo_hash" optional="show"/>
                    <field name="quickbook_sync_token" optional="show"/>
                </xpath>
            </field>
        </record>

        <record id="view_invoice_bill_tree_inherit" model="ir.ui.view">
            <field name="name">account.move.list</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_bill_tree"/>
            <field name="arch" type="xml">
                <xpath expr="field[@name='name']" position="after">
                    <field name="quickbook_id" optional="show"/>
                    <field name="quickbook_account_name" optional="show"/>
                    <field name="sync_to_quickbook" optional="show" widget="boolean_toggle"/>
                    <field name="odoo_hash" optional="show"/>
                    <field name="quickbook_sync_token" optional="show"/>
                </xpath>
            </field>
        </record>

         <record id="view_refund_tree_inherit" model="ir.ui.view">
            <field name="name">account.move.list</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_in_invoice_refund_tree"/>
            <field name="arch" type="xml">
                <xpath expr="field[@name='name']" position="after">
                    <field name="quickbook_refund_id" optional="show"/>
                    <field name="quickbook_account_name" optional="show"/>
                    <field name="sync_to_quickbook" optional="show" widget="boolean_toggle"/>
                    <field name="odoo_refund_hash" optional="show"/>
                    <field name="quickbook_sync_token" optional="show"/>
                </xpath>
            </field>
        </record>


        <record id="action_res_purchase_order_list_view_add_button" model="ir.actions.server">
            <field name="name">Sync To Quickbook</field>
            <field name="type">ir.actions.server</field>
            <field name="model_id" ref="model_purchase_order"/>
            <field name="binding_model_id" ref="model_purchase_order"/>
            <field name="binding_view_types">list</field>
            <field name="state">code</field>
            <field name="code">
                model.purchase_order_send_to_quickbook()
            </field>
        </record>

    </data>
</odoo>