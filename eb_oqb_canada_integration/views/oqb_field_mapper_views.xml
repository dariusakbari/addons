<odoo>

    <record id="view_oqb_coa_mapper_list" model="ir.ui.view">
        <field name="name">oqb.coa.mapper.list</field>
        <field name="model">oqb.coa.mapper</field>
        <field name="arch" type="xml">
            <list>
                
                <field name="internal_name"/>
                <field name="label_name"/>
