<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="view_oqb_wizard_form">
        <field name="name">oqb.wizard.form</field>
        <field name="model">oqb.wizard</field>
        <field name="arch" type="xml">
            <form string="Manual Push Quickbook to Odoo Records">
                <style>
                    .modal-dialog {
                        position: relative;
                        width: 600px;
                        height: 400px;
                        margin: 0.5rem;
                        pointer-events: none;
                    }
                    .o_input {
                        border: 1px solid var(--o-input-border-color);
                        border-width: 0 0 1px 0;
                        padding: 2px 4px;
                    }
                </style>
               <group>
                   <field name="quickbook_module_name"/>
                   <field name="quickbook_instance" options="{'no_create': True}"/>
                   <field name="quickbook_record_id" placeholder="1,2,3"/>
               </group>
                <p style="color:red;"><b>Notes: </b>For multiple records push, the format will be <b>1,2,3</b>. For single record push, the format will be <b>1</b>.</p>
                <footer>
                    <button name="action_send_record_quickbook_to_odoo" type="object" string="Sync Quickbook to Odoo" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_oqb_wizard">
        <field name="name">Manual Push Quickbook to Odoo Records</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">oqb.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_oqb_wizard"
              parent="menu_oqb_root"
              action="action_oqb_wizard"
              name="Quickbook to Odoo"
              sequence="6"/>

