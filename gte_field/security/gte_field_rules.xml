<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_dsl_member" model="ir.rule">
        <field name="name">Daily Log: project members</field>
        <field name="model_id" ref="model_gte_daily_log"/>
        <field name="groups" eval="[(4, ref('gte_core.group_gte_field'))]"/>
        <field name="domain_force">['|', ('project_id.privacy_visibility', '!=', 'followers'), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_dsl_manager" model="ir.rule">
        <field name="name">Daily Log: managers all</field>
        <field name="model_id" ref="model_gte_daily_log"/>
        <field name="groups" eval="[(4, ref('gte_core.group_gte_pm')), (4, ref('gte_core.group_gte_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
