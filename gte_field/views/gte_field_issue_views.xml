<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gte_fi_form" model="ir.ui.view">
        <field name="name">gte.field.issue.form</field>
        <field name="model">gte.field.issue</field>
        <field name="arch" type="xml">
            <form string="Field Issue">
                <header>
                    <button name="action_submit" string="Send to PM" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_release_rfi" string="Release RFI" type="object" class="btn-primary" invisible="state != 'submitted'" groups="gte_core.group_gte_pm"/>
                    <button name="action_resolve" string="Resolve Without RFI" type="object" invisible="state != 'submitted'" groups="gte_core.group_gte_pm"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft','submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,converted"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="title" placeholder="Short summary — e.g. Beam clashes with duct in G102"/>
                            <field name="project_id"/>
                            <field name="issue_type"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="raised_by_id"/>
                            <field name="location"/>
                            <field name="drawing_refs"/>
                            <field name="rfi_id" invisible="not rfi_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="What did you find? Required before sending to the PM."/>
                    </group>
                    <group string="Photos">
                        <field name="photo_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_fi_list" model="ir.ui.view">
        <field name="name">gte.field.issue.list</field>
        <field name="model">gte.field.issue</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="issue_type"/>
                <field name="raised_by_id"/>
                <field name="rfi_id" optional="show"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gte_fi" model="ir.actions.act_window">
        <field name="name">Field Issues</field>
        <field name="res_model">gte.field.issue</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_gte_fi" name="Field Issues" parent="gte_hse.menu_gte_field_safety" action="action_gte_fi" sequence="3"/>
</odoo>
