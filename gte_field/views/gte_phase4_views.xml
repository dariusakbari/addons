<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Punch / Deficiency -->
    <record id="view_gte_punch_form" model="ir.ui.view">
        <field name="name">gte.punch.item.form</field>
        <field name="model">gte.punch.item</field>
        <field name="arch" type="xml">
            <form string="Deficiency">
                <header>
                    <button name="action_start" string="Start" type="object" invisible="state != 'open'"/>
                    <button name="action_ready" string="Ready to Verify" type="object" class="btn-primary" invisible="state != 'in_progress'"/>
                    <button name="action_close" string="Close" type="object" class="btn-primary" invisible="state != 'verify'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('closed','cancelled')"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,in_progress,verify,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="location"/>
                            <field name="responsible_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group>
                            <field name="date_identified"/>
                            <field name="date_required"/>
                            <field name="inspection_id" readonly="1" invisible="not inspection_id"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                        <field name="corrective_action" placeholder="Required before marking ready to verify"/>
                    </group>
                    <group>
                        <group string="Before"><field name="photo_before_ids" widget="many2many_binary" nolabel="1"/></group>
                        <group string="After"><field name="photo_after_ids" widget="many2many_binary" nolabel="1"/></group>
                    </group>
                    <group invisible="state != 'closed'">
                        <field name="verified_by_id"/>
                        <field name="date_closed"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_punch_list" model="ir.ui.view">
        <field name="name">gte.punch.item.list</field>
        <field name="model">gte.punch.item</field>
        <field name="arch" type="xml">
            <list decoration-danger="priority == '2'" decoration-warning="priority == '1'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="location"/>
                <field name="responsible_id"/>
                <field name="priority" widget="priority"/>
                <field name="date_required"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gte_punch" model="ir.actions.act_window">
        <field name="name">Deficiencies / Punch List</field>
        <field name="res_model">gte.punch.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Meeting -->
    <record id="view_gte_meeting_form" model="ir.ui.view">
        <field name="name">gte.meeting.form</field>
        <field name="model">gte.meeting</field>
        <field name="arch" type="xml">
            <form string="Meeting Minutes">
                <header>
                    <button name="action_issue" string="Issue Minutes" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,issued"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="meeting_type"/>
                            <field name="date"/>
                            <field name="location"/>
                            <field name="chair_id"/>
                        </group>
                        <group>
                            <field name="attendee_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Agenda"><field name="agenda"/></page>
                        <page string="Discussion &amp; Decisions"><field name="discussion"/></page>
                        <page string="Action Items">
                            <field name="action_ids">
                                <list editable="bottom">
                                    <field name="description"/>
                                    <field name="owner_user_id"/>
                                    <field name="owner_partner_id"/>
                                    <field name="due_date"/>
                                    <field name="related_rfi_id"/>
                                    <field name="related_co_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_meeting_list" model="ir.ui.view">
        <field name="name">gte.meeting.list</field>
        <field name="model">gte.meeting</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="meeting_type"/>
                <field name="date"/>
                <field name="chair_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gte_meeting" model="ir.actions.act_window">
        <field name="name">Meeting Minutes</field>
        <field name="res_model">gte.meeting</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Closeout -->
    <record id="view_gte_closeout_form" model="ir.ui.view">
        <field name="name">gte.closeout.item.form</field>
        <field name="model">gte.closeout.item</field>
        <field name="arch" type="xml">
            <form string="Closeout Item">
                <header>
                    <button name="action_received" string="Received" type="object" invisible="state not in ('required',)"/>
                    <button name="action_reviewed" string="Reviewed" type="object" invisible="state != 'received'"/>
                    <button name="action_accepted" string="Accept" type="object" class="btn-primary" invisible="state != 'reviewed'"/>
                    <button name="action_na" string="N/A" type="object" invisible="state in ('accepted','na')"/>
                    <field name="state" widget="statusbar" statusbar_visible="required,received,reviewed,accepted"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="project_id"/>
                            <field name="category"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="date_required"/>
                            <field name="date_received" readonly="1"/>
                            <field name="date_reviewed" readonly="1"/>
                            <field name="date_accepted" readonly="1"/>
                        </group>
                    </group>
                    <group string="Documents">
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_closeout_list" model="ir.ui.view">
        <field name="name">gte.closeout.item.list</field>
        <field name="model">gte.closeout.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="category"/>
                <field name="date_required"/>
                <field name="date_accepted"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gte_closeout" model="ir.actions.act_window">
        <field name="name">Closeout Register</field>
        <field name="res_model">gte.closeout.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Inspection: deficiency smart button + create -->
    <record id="view_gte_gi_form_defic" model="ir.ui.view">
        <field name="name">gte.inspection.form.deficiency</field>
        <field name="model">gte.inspection</field>
        <field name="inherit_id" ref="gte_field.view_gte_inspection_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_view_deficiencies" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="punch_count == 0">
                        <field name="punch_count" widget="statinfo" string="Deficiencies"/>
                    </button>
                </div>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_create_deficiency" string="Log Deficiency" type="object" invisible="state == 'draft'"/>
            </xpath>
        </field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_gte_punch" name="Deficiencies / Punch" parent="gte_hse.menu_gte_field_safety" action="action_gte_punch" sequence="115"/>
    <menuitem id="menu_gte_meeting" name="Meeting Minutes" parent="gte_controls.menu_gte_docflow" action="action_gte_meeting" sequence="30"/>
    <menuitem id="menu_gte_closeout" name="Closeout Register" parent="gte_controls.menu_gte_docflow" action="action_gte_closeout" sequence="40"/>
</odoo>
