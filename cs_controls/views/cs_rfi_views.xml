<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_rfi_form" model="ir.ui.view">
        <field name="name">cs.rfi.form</field>
        <field name="model">cs.rfi</field>
        <field name="arch" type="xml">
            <form string="RFI">
                <header>
                    <!-- One clear primary action per state. Send RFI also
                         emails it (see cs_mail). Secondary actions (Resend,
                         Cancel, Reopen, Reminder) live in the cog Actions menu. -->
                    <button name="action_send" string="Send RFI" type="object" class="btn-primary" invisible="state not in ('draft','open')"/>
                    <button name="action_answer" string="Record Response" type="object" class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_distribute" string="Distribute Response" type="object" class="btn-primary" invisible="state != 'answered'"/>
                    <button name="action_close" string="Close RFI" type="object" class="btn-primary" invisible="state != 'distributed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,sent,answered,distributed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="project_id"/>
                            <field name="raised_by_id"/>
                            <field name="addressed_to_id"/>
                            <field name="coordinator_id"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="date_raised"/>
                            <field name="date_required"/>
                            <field name="date_answered" readonly="1"/>
                            <field name="date_distributed" readonly="1"/>
                            <field name="drawing_refs"/>
                            <field name="spec_refs"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question"><field name="question"/></page>
                        <page string="Response">
                            <group>
                                <group>
                                    <field name="responded_by_id"/>
                                </group>
                                <group>
                                    <field name="not_distributed_reason" invisible="date_distributed != False"/>
                                </group>
                            </group>
                            <field name="response"/>
                        </page>
                        <page string="Impacts">
                            <group>
                                <group>
                                    <field name="cost_impact"/>
                                    <field name="cost_amount" invisible="cost_impact != 'yes'"/>
                                    <field name="change_order_id"/>
                                </group>
                                <group>
                                    <field name="schedule_impact"/>
                                    <field name="schedule_days" invisible="schedule_impact != 'yes'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Distribution"><field name="distribution_ids" widget="many2many_tags"/></page>
                        <page string="Links">
                            <group>
                                <field name="task_ids" widget="many2many_tags"/>
                                <field name="origin_task_id"/>
                                <field name="legacy_source_id"/>
                                <field name="migration_incomplete"/>
                                <field name="migration_missing_fields" invisible="not migration_incomplete"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_cs_rfi_list" model="ir.ui.view">
        <field name="name">cs.rfi.list</field>
        <field name="model">cs.rfi</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue">
                <field name="name"/>
                <field name="subject"/>
                <field name="project_id"/>
                <field name="coordinator_id"/>
                <field name="date_required"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"/>
                <field name="migration_incomplete" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_cs_rfi_search" model="ir.ui.view">
        <field name="name">cs.rfi.search</field>
        <field name="model">cs.rfi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="project_id"/>
                <filter name="overdue" string="Overdue" domain="[('date_required', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'in', ['draft','open','sent'])]"/>
                <filter name="open_states" string="In Progress" domain="[('state', 'in', ('draft','open','sent','answered'))]"/>
                <filter name="mig_exceptions" string="Migration Exceptions" domain="[('migration_incomplete', '=', True)]"/>
                <separator/>
                <filter name="by_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
    <!-- Secondary RFI actions live in the form's Actions (cog) menu. -->
    <record id="action_server_rfi_cancel" model="ir.actions.server">
        <field name="name">Cancel RFI</field>
        <field name="model_id" ref="model_cs_rfi"/>
        <field name="binding_model_id" ref="model_cs_rfi"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = records.with_context(cs_action='cancel').action_open_reason_wizard()</field>
    </record>
    <record id="action_server_rfi_reopen" model="ir.actions.server">
        <field name="name">Reopen RFI</field>
        <field name="model_id" ref="model_cs_rfi"/>
        <field name="binding_model_id" ref="model_cs_rfi"/>
        <field name="binding_view_types">form</field>
        <field name="groups_id" eval="[(4, ref('cs_core.group_cs_pm'))]"/>
        <field name="state">code</field>
        <field name="code">action = records.with_context(cs_action='reopen').action_open_reason_wizard()</field>
    </record>

    <record id="action_cs_rfi" model="ir.actions.act_window">
        <field name="name">RFIs</field>
        <field name="res_model">cs.rfi</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open_states': 1}</field>
    </record>
</odoo>
