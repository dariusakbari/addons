<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cs_rfi" model="ir.actions.report">
        <field name="name">RFI</field>
        <field name="model">cs.rfi</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cs_controls.report_cs_rfi</field>
        <field name="report_file">cs_controls.report_cs_rfi</field>
