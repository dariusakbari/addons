<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_rfi_overdue" model="ir.cron">
        <field name="name">Construction: Overdue RFI escalation</field>
        <field name="model_id" ref="model_cs_rfi"/>
        <field name="state">code</field>
        <field name="code">model._cron_overdue_activities()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!-- Superseded by the cs_automation escalation engine (in-app only).
             Kept off so no automated per-item RFI notifications are sent. -->
        <field name="active" eval="False"/>
    </record>
</odoo>
