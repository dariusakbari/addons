<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Non-manager users see control records only on projects where they are
         members (followers) when the project uses follower visibility. -->
    <record id="rule_cs_rfi_member" model="ir.rule">
        <field name="name">RFI: project members</field>
        <field name="model_id" ref="model_cs_rfi"/>
        <field name="groups" eval="[(4, ref('cs_core.group_cs_field'))]"/>
        <field name="domain_force">['|', ('project_id.privacy_visibility', '!=', 'followers'), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_cs_rfi_manager" model="ir.rule">
        <field name="name">RFI: managers all</field>
        <field name="model_id" ref="model_cs_rfi"/>
        <field name="groups" eval="[(4, ref('cs_core.group_cs_pm')), (4, ref('cs_core.group_cs_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_cs_co_member" model="ir.rule">
        <field name="name">Change Order: project members</field>
        <field name="model_id" ref="model_cs_change_order"/>
        <field name="groups" eval="[(4, ref('cs_core.group_cs_field'))]"/>
        <field name="domain_force">['|', ('project_id.privacy_visibility', '!=', 'followers'), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_cs_co_manager" model="ir.rule">
        <field name="name">Change Order: managers all</field>
        <field name="model_id" ref="model_cs_change_order"/>
        <field name="groups" eval="[(4, ref('cs_core.group_cs_pm')), (4, ref('cs_core.group_cs_admin')), (4, ref('cs_core.group_cs_accounting'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_cs_submittal_member" model="ir.rule">
        <field name="name">Submittal: project members</field>
        <field name="model_id" ref="model_cs_submittal"/>
        <field name="groups" eval="[(4, ref('cs_core.group_cs_field'))]"/>
        <field name="domain_force">['|', ('project_id.privacy_visibility', '!=', 'followers'), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_cs_submittal_manager" model="ir.rule">
        <field name="name">Submittal: managers all</field>
        <field name="model_id" ref="model_cs_submittal"/>
        <field name="groups" eval="[(4, ref('cs_core.group_cs_pm')), (4, ref('cs_core.group_cs_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
