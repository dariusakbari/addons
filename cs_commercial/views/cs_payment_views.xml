<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_payapp_form" model="ir.ui.view">
        <field name="name">cs.payment.application.form</field>
        <field name="model">cs.payment.application</field>
        <field name="arch" type="xml">
            <form string="Payment Application">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Approve" type="object" class="btn-primary" invisible="state != 'submitted'" groups="cs_core.group_cs_accounting,cs_core.group_cs_admin"/>
                    <button name="action_create_invoice" string="Create Invoice" type="object" class="btn-primary" invisible="state != 'approved'" groups="cs_core.group_cs_accounting,cs_core.group_cs_admin"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state in ('invoiced','cancelled')"/>
                    <button name="action_reset" string="Reset to Draft" type="object" invisible="state == 'draft'" groups="cs_core.group_cs_pm"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,invoiced"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoice" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="not invoice_id">
                            <div class="o_stat_info"><span class="o_stat_text">Invoice</span></div>
                        </button>
                    </div>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id" readonly="state != 'draft'"/>
                            <field name="partner_id"/>
                            <field name="date_application"/>
                            <field name="period_start"/>
                            <field name="period_end"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="original_contract" readonly="state != 'draft'"/>
                            <field name="approved_co_total"/>
                            <field name="revised_contract"/>
                            <field name="holdback_percent" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <group string="Work Completed">
                        <group>
                            <field name="completed_to_date" readonly="state not in ('draft','submitted')"/>
                            <field name="percent_complete"/>
                            <field name="previous_completed"/>
                            <field name="this_period"/>
                        </group>
                        <group>
                            <field name="holdback_to_date"/>
                            <field name="this_period_holdback"/>
                            <field name="earned_less_holdback"/>
                            <field name="previous_payments"/>
                            <field name="current_due" class="oe_subtotal_footer_separator"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cs_payapp_list" model="ir.ui.view">
        <field name="name">cs.payment.application.list</field>
        <field name="model">cs.payment.application</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="period_end"/>
                <field name="percent_complete" optional="show"/>
                <field name="completed_to_date" optional="show"/>
                <field name="current_due" sum="Due"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_cs_payapp_search" model="ir.ui.view">
        <field name="name">cs.payment.application.search</field>
        <field name="model">cs.payment.application</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="project_id"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="approved" string="Approved" domain="[('state','=','approved')]"/>
                <filter name="invoiced" string="Invoiced" domain="[('state','=','invoiced')]"/>
                <separator/>
                <filter name="by_project" string="Project" context="{'group_by': 'project_id'}"/>
            </search>
        </field>
    </record>

    <record id="action_cs_payapp" model="ir.actions.act_window">
        <field name="name">Payment Applications</field>
        <field name="res_model">cs.payment.application</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_cs_payapp" name="Payment Applications" parent="menu_cs_commercial" action="action_cs_payapp" sequence="15"/>
</odoo>
