<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_cs_schedule" model="ir.ui.view">
        <field name="name">project.project.form.cs.schedule</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_cs_delays" type="object" class="oe_stat_button" icon="fa-hourglass-half" groups="cs_core.group_cs_coordinator">
                    <field name="cs_delay_count" widget="statinfo" string="Delays"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="cs_schedule_impact_days"/>
            </xpath>
        </field>
    </record>
    <!-- The project "Schedule" tab is owned by cs_hub (it consolidates
         baseline/forecast, look-aheads and delays into one place). This module
         no longer adds its own Schedule page to avoid a duplicate tab. -->
</odoo>
