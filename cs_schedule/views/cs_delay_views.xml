<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_delay_form" model="ir.ui.view">
        <field name="name">cs.delay.event.form</field>
        <field name="model">cs.delay.event</field>
        <field name="arch" type="xml">
            <form string="Delay Event">
                <header>
                    <button name="action_give_notice" string="Record Notice Given" type="object" class="btn-primary" invisible="notice_given or not notice_required or state == 'closed'"/>
                    <button name="action_mitigate" string="Mark Mitigated" type="object" invisible="state != 'open'"/>
                    <button name="action_close" string="Close" type="object" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,mitigated,closed"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Notice Overdue" bg_color="text-bg-danger" invisible="not notice_overdue"/>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="date_end"/>
                            <field name="cause"/>
                            <field name="days_impact"/>
                            <field name="critical_path"/>
                        </group>
                        <group>
                            <field name="delay_type"/>
                            <field name="responsible_id"/>
                            <field name="liable_party"/>
                            <field name="cost_impact"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="cost_amount" invisible="cost_impact != 'yes'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="What happened and how it affected the work..."/>
                        </page>
                        <page string="Mitigation &amp; Recovery">
                            <group>
                                <field name="mitigation_plan" placeholder="Steps to reduce or absorb the impact..."/>
                                <field name="recovery_plan" placeholder="Steps to recover lost time (resequencing, acceleration)..."/>
                            </group>
                        </page>
                        <page string="Notice">
                            <group>
                                <group>
                                    <field name="notice_required"/>
                                    <field name="notice_recipient_id" invisible="not notice_required"/>
                                    <field name="notice_deadline" invisible="not notice_required"/>
                                </group>
                                <group>
                                    <field name="notice_given"/>
                                    <field name="date_notice_given" invisible="not notice_given"/>
                                    <field name="notice_overdue" invisible="not notice_overdue"/>
                                </group>
                            </group>
                        </page>
                        <page string="Links">
                            <group>
                                <field name="rfi_id"/>
                                <field name="change_order_id"/>
                                <field name="daily_log_id"/>
                                <field name="field_issue_id"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_cs_delay_list" model="ir.ui.view">
        <field name="name">cs.delay.event.list</field>
        <field name="model">cs.delay.event</field>
        <field name="arch" type="xml">
            <list decoration-danger="notice_overdue or days_impact >= 5" decoration-warning="not notice_overdue and days_impact > 0 and days_impact &lt; 5">
                <field name="notice_overdue" column_invisible="1"/>
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="cause"/>
                <field name="liable_party" optional="show"/>
                <field name="days_impact" sum="Total days"/>
                <field name="critical_path" optional="show"/>
                <field name="cost_amount" optional="hide"/>
                <field name="notice_deadline" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_cs_delay_calendar" model="ir.ui.view">
        <field name="name">cs.delay.event.calendar</field>
        <field name="model">cs.delay.event</field>
        <field name="arch" type="xml">
            <calendar string="Delays" date_start="date" color="cause" mode="month">
                <field name="project_id"/>
                <field name="days_impact"/>
            </calendar>
        </field>
    </record>
    <record id="view_cs_delay_search" model="ir.ui.view">
        <field name="name">cs.delay.event.search</field>
        <field name="model">cs.delay.event</field>
        <field name="arch" type="xml">
            <search>
                <field name="project_id"/>
                <field name="cause"/>
                <field name="responsible_id"/>
                <filter name="open" string="Open" domain="[('state','=','open')]"/>
                <filter name="critical" string="Critical Path" domain="[('critical_path','=',True)]"/>
                <filter name="notice_overdue" string="Notice Overdue" domain="[('notice_required','=',True),('notice_given','=',False),('state','!=','closed'),('notice_deadline','!=',False),('notice_deadline','&lt;',context_today().strftime('%Y-%m-%d'))]"/>
                <filter name="compensable" string="Compensable" domain="[('delay_type','=','exc_comp')]"/>
                <separator/>
                <filter name="by_project" string="Project" context="{'group_by':'project_id'}"/>
                <filter name="by_cause" string="Cause" context="{'group_by':'cause'}"/>
                <filter name="by_liable" string="Liability" context="{'group_by':'liable_party'}"/>
            </search>
        </field>
    </record>
    <record id="action_cs_delay" model="ir.actions.act_window">
        <field name="name">Delay Events</field>
        <field name="res_model">cs.delay.event</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="context">{'search_default_open': 1}</field>
    </record>
</odoo>
