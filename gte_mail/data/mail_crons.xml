<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_gte_rfi_reminders" model="ir.cron">
        <field name="name">GTE: RFI response reminders</field>
        <field name="model_id" ref="gte_controls.model_gte_rfi"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
    <record id="cron_gte_submittal_reminders" model="ir.cron">
        <field name="name">GTE: Submittal on-site reminders</field>
        <field name="model_id" ref="gte_controls.model_gte_submittal"/>
        <field name="state">code</field>
        <field name="code">model._cron_send_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>