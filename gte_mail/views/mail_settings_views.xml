<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_gte_mail" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.gte.mail</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="gte_core.res_config_settings_view_form_gte"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='gte_construction']" position="inside">
                <block title="Email Readiness" help="Diagnostics for construction email. Actions are inactive until an outgoing mail server exists.">
                    <setting string="Mail readiness">
                        <field name="gte_mail_ready" invisible="1"/>
                        <field name="gte_mail_diag"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>