<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Non-manager users see control records only on projects where they are
         members (followers) when the project uses follower visibility. -->
    <record id="rule_gte_rfi_member" model="ir.rule">
        <field name="name">RFI: project members</field>
        <field name="model_id" ref="model_gte_rfi"/>
        <field name="groups" eval="[(4, ref('gte_core.group_gte_field'))]"/>
        <field name="domain_force">['|', ('project_id.privacy_visibility', '!=', 'followers'), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_gte_rfi_manager" model="ir.rule">
        <field name="name">RFI: managers all</field>
        <field name="model_id" ref="model_gte_rfi"/>
        <field name="groups" eval="[(4, ref('gte_core.group_gte_pm')), (4, ref('gte_core.group_gte_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_gte_co_member" model="ir.rule">
        <field name="name">Change Order: project members</field>
        <field name="model_id" ref="model_gte_change_order"/>
        <field name="groups" eval="[(4, ref('gte_core.group_gte_field'))]"/>
        <field name="domain_force">['|', ('project_id.privacy_visibility', '!=', 'followers'), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_gte_co_manager" model="ir.rule">
        <field name="name">Change Order: managers all</field>
        <field name="model_id" ref="model_gte_change_order"/>
        <field name="groups" eval="[(4, ref('gte_core.group_gte_pm')), (4, ref('gte_core.group_gte_admin')), (4, ref('gte_core.group_gte_accounting'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
    <record id="rule_gte_submittal_member" model="ir.rule">
        <field name="name">Submittal: project members</field>
        <field name="model_id" ref="model_gte_submittal"/>
        <field name="groups" eval="[(4, ref('gte_core.group_gte_field'))]"/>
        <field name="domain_force">['|', ('project_id.privacy_visibility', '!=', 'followers'), ('project_id.message_partner_ids', 'in', [user.partner_id.id])]</field>
    </record>
    <record id="rule_gte_submittal_manager" model="ir.rule">
        <field name="name">Submittal: managers all</field>
        <field name="model_id" ref="model_gte_submittal"/>
        <field name="groups" eval="[(4, ref('gte_core.group_gte_pm')), (4, ref('gte_core.group_gte_admin'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>
</odoo>
