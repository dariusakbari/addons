<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_gte_rfi" model="ir.actions.report">
        <field name="name">RFI</field>
        <field name="model">gte.rfi</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">gte_controls.report_gte_rfi</field>
        <field name="report_file">gte_controls.report_gte_rfi</field>
        <field name="print_report_name">'%s - %s' % (object.name, object.subject)</field>
