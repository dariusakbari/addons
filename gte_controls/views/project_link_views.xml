<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_gte" model="ir.ui.view">
        <field name="name">project.project.form.gte</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gte_rfis" type="object" class="oe_stat_button" icon="fa-question-circle" groups="gte_core.group_gte_coordinator">
                    <field name="gte_rfi_count" widget="statinfo" string="RFIs"/>
                </button>
                <button name="action_view_gte_cos" type="object" class="oe_stat_button" icon="fa-exchange" groups="gte_core.group_gte_coordinator,gte_core.group_gte_estimator">
                    <field name="gte_co_count" widget="statinfo" string="Change Orders"/>
                </button>
                <button name="action_view_gte_submittals" type="object" class="oe_stat_button" icon="fa-file-text-o" groups="gte_core.group_gte_coordinator">
                    <field name="gte_submittal_count" widget="statinfo" string="Submittals"/>
                </button>
            </xpath>
        </field>
    </record>
    <record id="view_task_form_gte" model="ir.ui.view">
        <field name="name">project.task.form.gte</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gte_rfis" type="object" class="oe_stat_button" icon="fa-question-circle" invisible="gte_rfi_count == 0" groups="gte_core.group_gte_coordinator">
                    <field name="gte_rfi_count" widget="statinfo" string="RFIs"/>
                </button>
                <button name="action_view_gte_cos" type="object" class="oe_stat_button" icon="fa-exchange" invisible="gte_co_count == 0" groups="gte_core.group_gte_coordinator,gte_core.group_gte_estimator">
                    <field name="gte_co_count" widget="statinfo" string="Change Orders"/>
                </button>
                <button name="action_view_gte_submittals" type="object" class="oe_stat_button" icon="fa-file-text-o" invisible="gte_submittal_count == 0" groups="gte_core.group_gte_coordinator">
                    <field name="gte_submittal_count" widget="statinfo" string="Submittals"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
