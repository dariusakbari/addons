<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_gte_rfi_form" model="ir.ui.view">
        <field name="name">gte.rfi.form</field>
        <field name="model">gte.rfi</field>
        <field name="arch" type="xml">
            <form string="RFI">
                <header>
                    <button name="action_open" string="Open" type="object" invisible="state != 'draft'"/>
                    <button name="action_send" string="Send" type="object" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_answer" string="Record Answer" type="object" class="btn-primary" invisible="state != 'sent'"/>
                    <button name="action_distribute" string="Distribute" type="object" class="btn-primary" invisible="state != 'answered'"/>
                    <button name="action_close" string="Close" type="object" invisible="state not in ('answered','distributed')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft','open','sent')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,open,sent,answered,distributed,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="subject"/>
                            <field name="project_id"/>
                            <field name="raised_by_id"/>
                            <field name="addressed_to_id"/>
                            <field name="coordinator_id"/>
                            <field name="priority"/>
                        </group>
                        <group>
                            <field name="date_raised"/>
                            <field name="date_required"/>
                            <field name="date_answered" readonly="1"/>
                            <field name="date_distributed" readonly="1"/>
                            <field name="drawing_refs"/>
                            <field name="spec_refs"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Question"><field name="question"/></page>
                        <page string="Response"><field name="response"/></page>
                        <page string="Impacts">
                            <group>
                                <group>
                                    <field name="cost_impact"/>
                                    <field name="cost_amount" invisible="cost_impact != 'yes'"/>
                                    <field name="change_order_id"/>
                                </group>
                                <group>
                                    <field name="schedule_impact"/>
                                    <field name="schedule_days" invisible="schedule_impact != 'yes'"/>
                                </group>
                            </group>
                        </page>
                        <page string="Distribution"><field name="distribution_ids" widget="many2many_tags"/></page>
                        <page string="Links">
                            <group>
                                <field name="task_ids" widget="many2many_tags"/>
                                <field name="origin_task_id"/>
                                <field name="legacy_source_id"/>
                                <field name="migration_incomplete"/>
                                <field name="migration_missing_fields" invisible="not migration_incomplete"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_rfi_list" model="ir.ui.view">
        <field name="name">gte.rfi.list</field>
        <field name="model">gte.rfi</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue">
                <field name="name"/>
                <field name="subject"/>
                <field name="project_id"/>
                <field name="coordinator_id"/>
                <field name="date_required"/>
                <field name="is_overdue" column_invisible="1"/>
                <field name="state" widget="badge"/>
                <field name="migration_incomplete" optional="hide"/>
            </list>
        </field>
    </record>
    <record id="view_gte_rfi_search" model="ir.ui.view">
        <field name="name">gte.rfi.search</field>
        <field name="model">gte.rfi</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="subject"/>
                <field name="project_id"/>
                <filter name="overdue" string="Overdue" domain="[('is_overdue', '=', True)]"/>
                <filter name="open_states" string="In Progress" domain="[('state', 'in', ('draft','open','sent','answered'))]"/>
                <filter name="mig_exceptions" string="Migration Exceptions" domain="[('migration_incomplete', '=', True)]"/>
                <separator/>
                <filter name="by_project" string="Project" context="{'group_by': 'project_id'}"/>
                <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
            </search>
        </field>
    </record>
    <record id="action_gte_rfi" model="ir.actions.act_window">
        <field name="name">RFIs</field>
        <field name="res_model">gte.rfi</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open_states': 1}</field>
    </record>
</odoo>
