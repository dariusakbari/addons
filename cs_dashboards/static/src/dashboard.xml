<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="cs_dashboards.ConstructionDashboard">
        <div class="o_cs_dashboard">
            <div t-if="state.loading" class="text-center p-5 text-muted">Loading…</div>
            <div t-elif="!state.projects.length" class="text-center p-5 text-muted">
                No construction projects with activity yet.
            </div>
            <div t-else="" class="o_cs_wrap">
                <t t-foreach="state.projects" t-as="proj" t-key="proj.project_id">
                    <div class="o_cs_card">
                        <!-- header (click to open the project dashboard) -->
                        <div class="o_cs_card_head" t-on-click="() => this.openProject(proj.project_id)" title="Open project dashboard">
                            <span class="o_cs_code" t-esc="proj.code"/>
                            <span class="o_cs_pname" t-esc="proj.name"/>
                            <span t-if="proj.partner" class="o_cs_partner" t-esc="'· ' + proj.partner"/>
                            <span class="o_cs_tags">
                                <t t-foreach="proj.tags" t-as="tag" t-key="tag_index">
                                    <span class="o_cs_tag" t-esc="tag"/>
                                </t>
                            </span>
                        </div>

                        <!-- progress -->
                        <div class="o_cs_progress_row" t-on-click="() => this.open(proj.tasks_action)">
                            <div class="o_cs_bar">
                                <div class="o_cs_bar_fill" t-attf-style="width: {{proj.progress}}%;"/>
                            </div>
                            <span class="o_cs_pct" t-esc="proj.progress + '%'"/>
                            <span class="o_cs_tasks" t-esc="proj.tasks_done + ' / ' + proj.tasks_total + ' tasks · ' + proj.tasks_open + ' open'"/>
                            <span t-if="proj.activity.pending" class="o_cs_activity"
                                  t-att-data-over="proj.activity.overdue ? 1 : 0"
                                  t-on-click.stop="() => this.open(proj.activity.action)"
                                  title="Open this project's scheduled activities">
                                <i class="fa fa-bell"/>
                                <t t-esc="proj.activity.pending"/>
                                <t t-if="proj.activity.overdue" t-esc="' · ' + proj.activity.overdue + ' overdue'"/>
                            </span>
                        </div>

                        <!-- quick create actions -->
                        <div class="o_cs_quick">
                            <t t-foreach="proj.quick_actions" t-as="qa" t-key="qa.label">
                                <button class="o_cs_qa" t-on-click="() => this.open(qa.action)">
                                    <i t-attf-class="fa {{qa.icon}}"/>
                                    <t t-esc="qa.label"/>
                                </button>
                            </t>
                        </div>

                        <!-- metric sections -->
                        <div class="o_cs_sections">
                            <t t-foreach="proj.sections" t-as="sec" t-key="sec.name">
                                <div class="o_cs_section">
                                    <div class="o_cs_section_title" t-esc="sec.name"/>
                                    <div class="o_cs_stats">
                                        <t t-foreach="sec.metrics" t-as="m" t-key="m.label">
                                            <div class="o_cs_stat" t-att-data-tone="m.tone"
                                                 t-on-click="() => this.open(m.action)">
                                                <span class="o_cs_stat_val" t-esc="m.value"/>
                                                <span class="o_cs_stat_lbl" t-esc="m.label"/>
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </t>
                        </div>

                        <!-- commercial footer (managers only) -->
                        <div t-if="proj.money.length" class="o_cs_money">
                            <span class="o_cs_money_lock"><i class="fa fa-lock"/> Commercial</span>
                            <t t-foreach="proj.money" t-as="mm" t-key="mm.label">
                                <span class="o_cs_money_item" t-on-click="() => this.open(mm.action)">
                                    <span class="o_cs_money_lbl" t-esc="mm.label"/>
                                    <span class="o_cs_money_val" t-esc="mm.value"/>
                                </span>
                            </t>
                        </div>
                    </div>
                </t>
            </div>
        </div>
    </t>
</templates>
