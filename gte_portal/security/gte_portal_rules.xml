<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Portal users see ONLY records explicitly shared with their partner. -->
    <record id="rule_portal_rfi" model="ir.rule">
        <field name="name">Portal: only shared RFIs</field>
        <field name="model_id" ref="gte_controls.model_gte_rfi"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('gte_portal_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_portal_submittal" model="ir.rule">
        <field name="name">Portal: only shared submittals</field>
        <field name="model_id" ref="gte_controls.model_gte_submittal"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('gte_portal_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_portal_transmittal" model="ir.rule">
        <field name="name">Portal: only shared transmittals</field>
        <field name="model_id" ref="gte_field.model_gte_transmittal"/>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="domain_force">[('gte_portal_partner_ids', 'in', [user.partner_id.id])]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
