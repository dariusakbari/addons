<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Incident -->
    <record id="view_gte_incident_form" model="ir.ui.view">
        <field name="name">gte.incident.form</field>
        <field name="model">gte.incident</field>
        <field name="arch" type="xml">
            <form string="Incident">
                <header>
                    <button name="action_submit" string="Submit" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_investigate" string="Start Investigation" type="object" invisible="state != 'submitted'" groups="gte_core.group_gte_safety,gte_core.group_gte_pm"/>
                    <button name="action_close" string="Close" type="object" class="btn-primary" invisible="state not in ('submitted','investigation')" groups="gte_core.group_gte_safety,gte_core.group_gte_pm"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,investigation,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="location"/>
                            <field name="reported_by_id"/>
                        </group>
                        <group>
                            <field name="incident_type"/>
                            <field name="severity" widget="radio" options="{'horizontal': true}"/>
                            <field name="corrective_due"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="What Happened">
                            <group>
                                <field name="description" placeholder="Required before submitting"/>
                                <field name="people_involved"/>
                                <field name="injuries"/>
                                <field name="immediate_actions" placeholder="Required before submitting"/>
                            </group>
                        </page>
                        <page string="Investigation">
                            <group>
                                <field name="root_cause"/>
                                <field name="corrective_actions"/>
                                <field name="reviewed_by_id" invisible="not reviewed_by_id"/>
                                <field name="reviewed_date" invisible="not reviewed_date"/>
                            </group>
                        </page>
                        <page string="Evidence"><field name="photo_ids" widget="many2many_binary"/></page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_incident_list" model="ir.ui.view">
        <field name="name">gte.incident.list</field>
        <field name="model">gte.incident</field>
        <field name="arch" type="xml">
            <list decoration-danger="severity in ('serious','critical')">
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="incident_type"/>
                <field name="severity" widget="badge"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gte_incident" model="ir.actions.act_window">
        <field name="name">Incident Reports</field>
        <field name="res_model">gte.incident</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Equipment Inspection -->
    <record id="view_gte_eqi_form" model="ir.ui.view">
        <field name="name">gte.equipment.inspection.form</field>
        <field name="model">gte.equipment.inspection</field>
        <field name="arch" type="xml">
            <form string="Equipment Inspection">
                <header>
                    <button name="action_done" string="Complete" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,done"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="equipment_name"/>
                            <field name="serial_no"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="inspector_id"/>
                            <field name="result" widget="radio" options="{'horizontal': true}"/>
                            <field name="next_due"/>
                        </group>
                    </group>
                    <group>
                        <field name="defects" placeholder="Required if result is Fail"/>
                        <field name="action_taken"/>
                    </group>
                    <group string="Photos"><field name="photo_ids" widget="many2many_binary" nolabel="1"/></group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_eqi_list" model="ir.ui.view">
        <field name="name">gte.equipment.inspection.list</field>
        <field name="model">gte.equipment.inspection</field>
        <field name="arch" type="xml">
            <list decoration-danger="result == 'fail'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="equipment_name"/>
                <field name="date"/>
                <field name="result" widget="badge"/>
                <field name="next_due"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gte_eqi" model="ir.actions.act_window">
        <field name="name">Equipment Inspections</field>
        <field name="res_model">gte.equipment.inspection</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Work Permit -->
    <record id="view_gte_permit_form" model="ir.ui.view">
        <field name="name">gte.work.permit.form</field>
        <field name="model">gte.work.permit</field>
        <field name="arch" type="xml">
            <form string="Work Permit">
                <header>
                    <button name="action_activate" string="Activate" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_close" string="Close" type="object" invisible="state != 'active'"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="permit_type"/>
                            <field name="issued_by_id"/>
                            <field name="issued_to" placeholder="Required before activating"/>
                        </group>
                        <group>
                            <field name="valid_from"/>
                            <field name="valid_to"/>
                        </group>
                    </group>
                    <group>
                        <field name="description" placeholder="Required before activating"/>
                        <field name="conditions" placeholder="Required before activating"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_permit_list" model="ir.ui.view">
        <field name="name">gte.work.permit.list</field>
        <field name="model">gte.work.permit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="permit_type"/>
                <field name="valid_from"/>
                <field name="valid_to"/>
                <field name="issued_to"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gte_permit" model="ir.actions.act_window">
        <field name="name">Work Permits</field>
        <field name="res_model">gte.work.permit</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Risk Register -->
    <record id="view_gte_risk_form" model="ir.ui.view">
        <field name="name">gte.risk.form</field>
        <field name="model">gte.risk</field>
        <field name="arch" type="xml">
            <form string="Risk">
                <header>
                    <button name="action_mitigate" string="Mark Mitigated" type="object" class="btn-primary" invisible="state != 'open'"/>
                    <button name="action_close" string="Close" type="object" invisible="state == 'closed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="open,mitigated,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="title"/>
                            <field name="project_id"/>
                            <field name="category"/>
                            <field name="owner_id"/>
                        </group>
                        <group>
                            <field name="likelihood"/>
                            <field name="impact"/>
                            <field name="score"/>
                            <field name="review_date"/>
                        </group>
                    </group>
                    <group>
                        <field name="mitigation" placeholder="Required before marking mitigated"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_gte_risk_list" model="ir.ui.view">
        <field name="name">gte.risk.list</field>
        <field name="model">gte.risk</field>
        <field name="arch" type="xml">
            <list decoration-danger="score >= 15" decoration-warning="score >= 8 and score < 15">
                <field name="name"/>
                <field name="title"/>
                <field name="project_id"/>
                <field name="category"/>
                <field name="score"/>
                <field name="owner_id"/>
                <field name="review_date"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_gte_risk" model="ir.actions.act_window">
        <field name="name">Risk Register</field>
        <field name="res_model">gte.risk</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="cron_permit_expiry" model="ir.cron">
        <field name="name">GTE: Work permit expiry check</field>
        <field name="model_id" ref="model_gte_work_permit"/>
        <field name="state">code</field>
        <field name="code">model._cron_expire_permits()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>

    <menuitem id="menu_gte_incident" name="Incident Reports" parent="menu_gte_field_safety" action="action_gte_incident" sequence="30"/>
    <menuitem id="menu_gte_eqi" name="Equipment Inspections" parent="menu_gte_field_safety" action="action_gte_eqi" sequence="40"/>
    <menuitem id="menu_gte_permit" name="Work Permits" parent="menu_gte_field_safety" action="action_gte_permit" sequence="50"/>
    <menuitem id="menu_gte_risk" name="Risk Register" parent="menu_gte_field_safety" action="action_gte_risk" sequence="60"/>
</odoo>
