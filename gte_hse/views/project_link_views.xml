<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_form_gte_hse" model="ir.ui.view">
        <field name="name">project.project.form.gte.hse</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_gte_flhas" type="object" class="oe_stat_button" icon="fa-shield">
                    <field name="gte_flha_count" widget="statinfo" string="FLHAs"/>
                </button>
                <button name="action_view_gte_tbts" type="object" class="oe_stat_button" icon="fa-comments-o">
                    <field name="gte_tbt_count" widget="statinfo" string="Toolbox Talks"/>
                </button>
                <button name="action_view_gte_incidents" type="object" class="oe_stat_button" icon="fa-exclamation-triangle" invisible="gte_incident_count == 0">
                    <field name="gte_incident_count" widget="statinfo" string="Incidents"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
