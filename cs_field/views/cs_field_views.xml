<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_dsl_form" model="ir.ui.view">
        <field name="name">cs.daily.log.form</field>
        <field name="model">cs.daily.log</field>
        <field name="arch" type="xml">
            <form string="Daily Site Log">
                <header>
                    <button name="action_submit" string="Finalize" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_review" string="Supervisor Review" type="object" class="btn-primary" invisible="state != 'submitted'" groups="cs_core.group_cs_pm"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state not in ('draft','submitted')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,reviewed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="date"/>
                            <field name="foreman_id"/>
                        </group>
                        <group>
                            <field name="weather"/>
                            <field name="temperature"/>
                            <field name="total_hours"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Labour">
                            <field name="labour_ids">
                                <list editable="bottom">
                                    <field name="worker_name"/>
                                    <field name="classification"/>
                                    <field name="hours" sum="Total"/>
                                    <field name="notes"/>
                                </list>
                            </field>
                        </page>
                        <page string="Work">
                            <group>
                                <field name="work_done" placeholder="Required before finalizing"/>
                                <field name="quantities"/>
                                <field name="equipment"/>
                            </group>
                        </page>
                        <page string="Site Activity">
                            <group>
                                <field name="deliveries"/>
                                <field name="visitors"/>
                                <field name="delays"/>
                                <field name="safety_observations"/>
                            </group>
                        </page>
                        <page string="Photos">
                            <field name="photo_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Signature">
                            <group>
                                <field name="signature" widget="signature"/>
                                <field name="reviewed_by_id" invisible="not reviewed_by_id"/>
                                <field name="reviewed_date" invisible="not reviewed_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="view_cs_dsl_list" model="ir.ui.view">
        <field name="name">cs.daily.log.list</field>
        <field name="model">cs.daily.log</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="date"/>
                <field name="foreman_id"/>
                <field name="total_hours" sum="Hours"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="action_cs_dsl" model="ir.actions.act_window">
        <field name="name">Daily Site Logs</field>
        <field name="res_model">cs.daily.log</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_cs_dsl" name="Daily Site Logs" parent="cs_hse.menu_cs_field_safety" action="action_cs_dsl" sequence="5"/>
</odoo>
