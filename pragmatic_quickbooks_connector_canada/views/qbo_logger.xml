<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="qbo_import_export_log_form" model="ir.ui.view">
            <field name="name">qbo.logger.form</field>
            <field name="model">qbo.logger</field>
            <field name="arch" type="xml">
                <form string="Export Logs" name="Export Logs">
                    <sheet>
                        <group >
                            <field name="odoo_name"/>
                            <field name="odoo_object"/>
                            <field name="activity"/>
                            <field name="message"/>
                            <field name="created_date"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="qbd_import_export_log_tree" model="ir.ui.view">
            <field name="name">qbo.logger.tree</field>
            <field name="model">qbo.logger</field>
            <field name="arch" type="xml">
                <list string="Export Logs" name="Export Logs">
                    <field name="odoo_name"/>
                    <field name="odoo_object"/>
                    <field name="activity"/>
                    <field name="message"/>
                    <field name="created_date"/>
                </list>
            </field>
        </record>

        <record id="action_qbo_import_export_record" model="ir.actions.act_window">
            <field name="name">Import Export Log</field>
            <field name="res_model">qbo.logger</field>
            <field name="view_mode">list,form</field>
        </record>

<!--         <menuitem id="menu_qbo_logger_re" name="QBO Loggers" sequence="1" web_icon="pragmatic_quickbooks_connector_canada,static/description/log.png"/> -->
        <menuitem id="menu_qbo_import_export_logger" parent="pragmatic_quickbooks_connector_canada.menu_qb_dashboard" name="Logs" action="action_qbo_import_export_record" sequence="30"/>
    </data>
</odoo>