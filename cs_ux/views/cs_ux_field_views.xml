<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Daily Site Log (field "site report"): make Photos the first tab so
         field staff can attach pictures in one tap on a phone/tablet. -->
    <record id="view_cs_dsl_form_ux" model="ir.ui.view">
        <field name="name">cs.daily.log.form.ux</field>
        <field name="model">cs.daily.log</field>
        <field name="inherit_id" ref="cs_field.view_cs_dsl_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="before">
                <xpath expr="//page[field[@name='photo_ids']]" position="move"/>
            </xpath>
        </field>
    </record>

    <!-- Deficiency: move Before/After photos above the description so a field
         worker can snap the defect first, then describe it. -->
    <record id="view_cs_punch_form_ux" model="ir.ui.view">
        <field name="name">cs.punch.item.form.ux</field>
        <field name="model">cs.punch.item</field>
        <field name="inherit_id" ref="cs_field.view_cs_punch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[field[@name='description']]" position="before">
                <xpath expr="//group[group[field[@name='photo_before_ids']]]"
                       position="move"/>
            </xpath>
        </field>
    </record>

    <!-- Incident: make the Evidence (photos) tab first for quick on-site
         capture. -->
    <record id="view_cs_incident_form_ux" model="ir.ui.view">
        <field name="name">cs.incident.form.ux</field>
        <field name="model">cs.incident</field>
        <field name="inherit_id" ref="cs_hse.view_cs_incident_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position="before">
                <xpath expr="//page[field[@name='photo_ids']]" position="move"/>
            </xpath>
        </field>
    </record>

</odoo>
