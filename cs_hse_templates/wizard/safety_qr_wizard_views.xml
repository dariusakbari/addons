<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_safety_qr_wizard_form" model="ir.ui.view">
        <field name="name">cs.safety.qr.wizard.form</field>
        <field name="model">cs.safety.qr.wizard</field>
        <field name="arch" type="xml">
            <form string="Safety QR Poster">
                <group>
                    <field name="template_id" options="{'no_create': True}"/>
                    <field name="project_id" options="{'no_create': True}"/>
                </group>
                <div class="text-center">
                    <field name="qr_image" widget="image" options="{'size': [220, 220]}"/>
                    <p class="text-muted mt-2">
                        Scan to start a new report from this template.
                        Print this and post it at the site or on the equipment.
                    </p>
                    <field name="url" readonly="1" widget="CopyClipboardChar"/>
                </div>
                <footer>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="view_cs_safety_reopen_wizard_form" model="ir.ui.view">
        <field name="name">cs.safety.reopen.wizard.form</field>
        <field name="model">cs.safety.reopen.wizard</field>
        <field name="arch" type="xml">
            <form string="Reopen Safety Report">
                <p class="text-muted">
                    Reopening unlocks this report for editing. Your name, the date
                    and the reason below are recorded in the report's chatter.
                </p>
                <group>
                    <field name="report_id" invisible="1"/>
                    <field name="reason" placeholder="Why is this locked report being reopened?"/>
                </group>
                <footer>
                    <button string="Reopen" name="action_confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
