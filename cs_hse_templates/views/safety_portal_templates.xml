<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shown by /safety/new when the scanned QR has no valid project. -->
    <template id="safety_pick_project" name="Safety: select project">
        <html>
            <head>
                <title>Select a project</title>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body { font-family: Arial, sans-serif; margin: 0; padding: 24px;
                           color: #1f2937; background: #f7f8fa; }
                    h2 { margin: 0 0 4px; }
                    .sub { color: #6b7280; margin: 0 0 20px; }
                    a.proj { display: block; padding: 14px 16px; margin: 8px 0;
                             background: #fff; border: 1px solid #e5e7eb;
                             border-radius: 8px; text-decoration: none;
                             color: #0f766e; font-weight: 600; }
                    a.proj:active { background: #eef2f6; }
                    .empty { color: #6b7280; }
                </style>
            </head>
            <body>
                <h2><t t-esc="template.name"/></h2>
                <p class="sub">Select the project this report is for:</p>
                <t t-if="projects">
                    <a t-foreach="projects" t-as="p" class="proj"
                       t-attf-href="/safety/new?template_id={{template.id}}&amp;project_id={{p.id}}">
                        <t t-esc="p.display_name"/>
                    </a>
                </t>
                <p t-else="" class="empty">You have no projects available.</p>
            </body>
        </html>
    </template>

    <!-- Shown by /safety/new when a QR carries a project that no longer exists. -->
    <template id="safety_qr_invalid" name="Safety: invalid QR project">
        <html>
            <head>
                <title>QR out of date</title>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body { font-family: Arial, sans-serif; margin: 0; padding: 24px;
                           color: #1f2937; background: #f7f8fa; }
                    h2 { margin: 0 0 8px; }
                    p { color: #6b7280; }
                </style>
            </head>
            <body>
                <h2>This QR is out of date</h2>
                <p>The project on this <t t-esc="template.name"/> poster no longer
                   exists. Ask your supervisor for an updated QR poster.</p>
            </body>
        </html>
    </template>

    <!-- Print-ready, project-specific poster (/safety/qr_poster). -->
    <template id="safety_qr_poster" name="Safety QR poster">
        <html>
            <head>
                <title>QR — <t t-esc="template.name"/></title>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <style>
                    body { font-family: Arial, sans-serif; margin: 0; padding: 40px;
                           color: #14202e; text-align: center; }
                    .code { font-size: 18px; letter-spacing: 1px; color: #0f766e;
                            font-weight: 700; }
                    h1 { font-size: 34px; margin: 6px 0 2px; }
                    .proj { font-size: 22px; margin: 0 0 24px; color: #374151; }
                    img { width: 320px; height: 320px; }
                    .scan { font-size: 20px; font-weight: 600; margin-top: 18px; }
                    .hint { color: #6b7280; margin-top: 4px; }
                    .print { margin-top: 24px; }
                    @media print { .print { display: none; } body { padding: 20px; } }
                </style>
            </head>
            <body>
                <div class="code"><t t-esc="template.code or ''"/></div>
                <h1><t t-esc="template.name"/></h1>
                <p class="proj"><t t-esc="project.display_name"/></p>
                <img t-att-src="qr_uri" alt="QR"/>
                <div class="scan">Scan to start this safety report</div>
                <div class="hint">Sign in with your Odoo login the first time.</div>
                <button class="print" onclick="window.print()">Print this poster</button>
            </body>
        </html>
    </template>
</odoo>
