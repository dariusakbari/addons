<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_safety_template_form" model="ir.ui.view">
        <field name="name">cs.safety.template.form</field>
        <field name="model">cs.safety.template</field>
        <field name="arch" type="xml">
            <form string="Safety Template">
                <header>
                    <button name="action_publish" string="Publish" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_new_version" string="New Version"
                            type="object" invisible="state == 'draft'"/>
                    <button name="action_archive_template" string="Archive"
                            type="object" invisible="state != 'published'"/>
                    <button name="action_restore_draft" string="Back to Draft"
                            type="object" invisible="state != 'archived'"/>
                    <button name="action_print_qr" string="QR Poster"
                            type="object" icon="fa-qrcode"
                            invisible="state != 'published'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,published,archived"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_reports" type="object"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <field name="report_count" widget="statinfo"
                                   string="Reports"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="text-bg-secondary"
                            invisible="state != 'archived'"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="e.g. Daily Site Safety Inspection"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="template_type"/>
                            <field name="code" placeholder="INSP"/>
                        </group>
                        <group>
                            <field name="version"/>
                            <field name="section_count"/>
                            <field name="question_count"/>
                            <field name="require_photo_default"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="supersedes_id" invisible="not supersedes_id"/>
                        </group>
                    </group>
                    <field name="intro" placeholder="Optional instructions shown on the report and PDF..."/>
                    <separator string="Sections &amp; Questions"/>
                    <field name="section_ids" readonly="state != 'draft'">
                        <list string="Sections">
                            <field name="sequence" widget="handle"/>
                            <field name="name"/>
                            <field name="instruction" optional="hide"/>
                        </list>
                        <form string="Section">
                            <group>
                                <field name="name"/>
                                <field name="instruction"/>
                            </group>
                            <separator string="Questions"/>
                            <field name="question_ids">
                                <list string="Questions" editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="qtype"/>
                                    <field name="yesno_pass"
                                           readonly="qtype != 'yesno'"
                                           optional="show"/>
                                    <field name="required"/>
                                    <field name="requires_photo"/>
                                    <field name="corrective_on_fail"/>
                                    <field name="help_text" optional="hide"/>
                                </list>
                            </field>
                        </form>
                    </field>
                    <p class="text-muted" invisible="state == 'draft'">
                        This template is locked. Use <strong>New Version</strong> to change it —
                        existing reports keep referring to the version they were created from.
                    </p>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_cs_safety_template_list" model="ir.ui.view">
        <field name="name">cs.safety.template.list</field>
        <field name="model">cs.safety.template</field>
        <field name="arch" type="xml">
            <list string="Safety Templates" decoration-muted="state == 'archived'">
                <field name="name"/>
                <field name="code" optional="show"/>
                <field name="template_type"/>
                <field name="version"/>
                <field name="section_count" optional="hide"/>
                <field name="question_count"/>
                <field name="report_count"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'published'"
                       decoration-muted="state == 'archived'"/>
            </list>
        </field>
    </record>

    <record id="view_cs_safety_template_search" model="ir.ui.view">
        <field name="name">cs.safety.template.search</field>
        <field name="model">cs.safety.template</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <filter name="published" string="Published" domain="[('state','=','published')]"/>
                <filter name="draft" string="Draft" domain="[('state','=','draft')]"/>
                <filter name="archived" string="Archived" domain="[('active','=',False)]"/>
                <separator/>
                <filter name="by_type" string="Type" context="{'group_by':'template_type'}"/>
            </search>
        </field>
    </record>

    <record id="action_cs_safety_template" model="ir.actions.act_window">
        <field name="name">Safety Templates</field>
        <field name="res_model">cs.safety.template</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_published': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Build your first safety template</p>
            <p>Define reusable toolbox talks, inspections, hazard assessments and checklists.
               Publish a template to make it available for field reports.</p>
        </field>
    </record>
</odoo>
