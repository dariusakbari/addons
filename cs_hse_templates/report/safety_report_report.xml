<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_cs_safety" model="ir.actions.report">
        <field name="name">Safety Report</field>
        <field name="model">cs.safety.report</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">cs_hse_templates.report_cs_safety</field>
        <field name="report_file">cs_hse_templates.report_cs_safety</field>
        <field name="print_report_name">(object.name or 'Safety Report')</field>
        <field name="binding_model_id" ref="model_cs_safety_report"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_cs_safety">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 style="margin-bottom:0;">
                            <span t-field="doc.name"/>
                        </h2>
                        <div class="text-muted" style="margin-bottom:8px;">
                            <span t-field="doc.template_id.name"/>
                            (v<span t-esc="doc.template_version"/>) —
                            <span t-field="doc.template_type"/>
                        </div>

                        <table class="table table-sm" style="margin-bottom:10px;">
                            <tr>
                                <td style="width:25%;"><strong>Project</strong></td>
                                <td style="width:25%;"><span t-field="doc.project_id"/></td>
                                <td style="width:25%;"><strong>Date</strong></td>
                                <td style="width:25%;"><span t-field="doc.date"/></td>
                            </tr>
                            <tr>
                                <td><strong>Location</strong></td>
                                <td><span t-field="doc.location"/></td>
                                <td><strong>Prepared By</strong></td>
                                <td><span t-field="doc.prepared_by_id"/></td>
                            </tr>
                            <tr>
                                <td><strong>Supervisor</strong></td>
                                <td><span t-field="doc.supervisor_id"/></td>
                                <td><strong>Result</strong></td>
                                <td>
                                    <span t-if="doc.overall_result == 'pass'"
                                          class="badge text-bg-success">Pass</span>
                                    <span t-if="doc.overall_result == 'attention'"
                                          class="badge text-bg-danger">Needs Attention</span>
                                    <span t-if="doc.overall_result == 'na'"
                                          class="badge text-bg-secondary">N/A</span>
                                    <span t-esc="doc.fail_count"/> failed
                                </td>
                            </tr>
                        </table>

                        <div t-if="doc.intro" t-field="doc.intro"
                             style="margin-bottom:10px;"/>

                        <t t-set="current_section" t-value="False"/>
                        <table class="table table-sm o_main_table">
                            <t t-foreach="doc.answer_ids" t-as="a">
                                <tr t-if="a.section_name != current_section"
                                    style="background-color:#f0f0f0;">
                                    <td colspan="3">
                                        <strong t-esc="a.section_name"/>
                                        <t t-set="current_section" t-value="a.section_name"/>
                                    </td>
                                </tr>
                                <tr t-att-style="a.is_fail and 'background-color:#fdecec;' or ''">
                                    <td style="width:55%;">
                                        <span t-field="a.question_name"/>
                                        <div t-if="a.comment" class="text-muted"
                                             style="font-size:9px;">
                                            <span t-field="a.comment"/>
                                        </div>
                                    </td>
                                    <td style="width:20%;">
                                        <t t-if="a.qtype == 'passfailna'">
                                            <span t-field="a.value_pfn"/>
                                        </t>
                                        <t t-if="a.qtype == 'yesno'">
                                            <span t-field="a.value_yn"/>
                                        </t>
                                        <t t-if="a.qtype == 'rating'">
                                            <span t-field="a.value_rating"/>/5
                                        </t>
                                        <t t-if="a.qtype == 'number'">
                                            <span t-field="a.value_number"/>
                                        </t>
                                        <t t-if="a.qtype == 'text'">
                                            <span t-field="a.value_text"/>
                                        </t>
                                    </td>
                                    <td style="width:25%;">
                                        <div t-if="a.corrective_action">
                                            <strong style="font-size:9px;">Corrective:</strong>
                                            <span t-field="a.corrective_action"/>
                                        </div>
                                        <t t-if="a.photo_ids">
                                            <t t-foreach="a.photo_ids" t-as="ph">
                                                <img t-if="ph.datas"
                                                     t-att-src="image_data_uri(ph.datas)"
                                                     style="max-height:60px;max-width:80px;margin:2px;"/>
                                            </t>
                                        </t>
                                    </td>
                                </tr>
                            </t>
                        </table>

                        <h4 style="margin-top:14px;">Signatures</h4>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Role</th><th>Name</th><th>Signature</th><th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.signature_ids" t-as="s">
                                    <td><span t-field="s.role"/></td>
                                    <td><span t-field="s.signer_name"/></td>
                                    <td>
                                        <img t-if="s.signature"
                                             t-att-src="image_data_uri(s.signature)"
                                             style="max-height:45px;"/>
                                    </td>
                                    <td><span t-field="s.signed_on"/></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="text-muted" style="font-size:9px;margin-top:12px;">
                            <span t-field="doc.name"/> · template v<span t-esc="doc.template_version"/>
                            · status <span t-field="doc.state"/>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
