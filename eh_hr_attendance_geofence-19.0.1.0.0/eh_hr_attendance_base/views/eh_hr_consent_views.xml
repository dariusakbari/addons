<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_eh_hr_consent_list" model="ir.ui.view">
            <field name="name">eh.hr.consent.list</field>
            <field name="model">eh.hr.consent</field>
            <field name="arch" type="xml">
                <list string="Consent records" sample="1" decoration-success="state == 'granted'" decoration-warning="state == 'pending'" decoration-muted="state in ('withdrawn', 'expired')">
                    <field name="employee_id"/>
                    <field name="consent_type"/>
                    <field name="state"/>
                    <field name="granted_on"/>
                    <field name="expires_on"/>
                    <field name="withdrawn_on" optional="hide"/>
                    <field name="granted_via" optional="hide"/>
                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                </list>
            </field>
        </record>

        <record id="view_eh_hr_consent_form" model="ir.ui.view">
            <field name="name">eh.hr.consent.form</field>
            <field name="model">eh.hr.consent</field>
            <field name="arch" type="xml">
                <form string="Consent record">
                    <header>
                        <button name="action_grant" type="object" string="Grant" class="oe_highlight" invisible="state == 'granted'"/>
                        <button name="action_withdraw" type="object" string="Withdraw" invisible="state in ('withdrawn', 'pending')"/>
                        <field name="state" widget="statusbar" statusbar_visible="pending,granted,withdrawn"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" readonly="1"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="employee_id"/>
                                <field name="consent_type"/>
                                <field name="granted_via"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                            <group>
                                <field name="granted_on" readonly="state != 'granted'"/>
                                <field name="expires_on" readonly="state != 'granted'"/>
                                <field name="withdrawn_on" readonly="state != 'withdrawn'" invisible="state != 'withdrawn'"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Consent text">
                                <field name="consent_text" placeholder="Snapshot of the consent prose displayed to the employee at grant time."/>
                            </page>
                            <page string="Evidence">
                                <field name="evidence" filename="evidence_filename"/>
                                <field name="evidence_filename" invisible="1"/>
                            </page>
                            <page string="Notes">
                                <field name="notes"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="view_eh_hr_consent_search" model="ir.ui.view">
            <field name="name">eh.hr.consent.search</field>
            <field name="model">eh.hr.consent</field>
            <field name="arch" type="xml">
                <search string="Consent records">
                    <field name="employee_id"/>
                    <field name="consent_type"/>
                    <filter string="Granted" name="filter_granted" domain="[('state', '=', 'granted')]"/>
                    <filter string="Pending" name="filter_pending" domain="[('state', '=', 'pending')]"/>
                    <filter string="Withdrawn" name="filter_withdrawn" domain="[('state', '=', 'withdrawn')]"/>
                    <filter string="Expired" name="filter_expired" domain="[('state', '=', 'expired')]"/>
                    <separator/>
                    <filter string="Face" name="filter_face" domain="[('consent_type', '=', 'face')]"/>
                    <filter string="Geolocation" name="filter_geo" domain="[('consent_type', '=', 'geolocation')]"/>
                    <group>
                        <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                        <filter string="Type" name="group_type" context="{'group_by': 'consent_type'}"/>
                        <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="action_eh_hr_consent" model="ir.actions.act_window">
            <field name="name">Consent records</field>
            <field name="res_model">eh.hr.consent</field>
            <field name="view_mode">list,form</field>
            <field name="search_view_id" ref="view_eh_hr_consent_search"/>
            <field name="context">{'search_default_filter_granted': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">No consent records yet.</p>
                <p>Records are created automatically when an employee enrols at a kiosk, or manually by an HR administrator from the employee's profile.</p>
            </field>
        </record>

    </data>
</odoo>
