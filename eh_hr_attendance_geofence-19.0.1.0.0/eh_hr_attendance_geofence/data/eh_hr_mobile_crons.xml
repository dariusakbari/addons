<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Expire lapsed pairing PINs and purge old terminal rows daily.
             Odoo 19 dropped the ir.cron numbercall/doall fields. -->
        <record id="cron_eh_hr_mobile_pairing_gc" model="ir.cron">
            <field name="name">EH HR: expire mobile pairing PINs</field>
            <field name="model_id" ref="model_eh_hr_mobile_pairing"/>
            <field name="state">code</field>
            <field name="code">model._gc_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
