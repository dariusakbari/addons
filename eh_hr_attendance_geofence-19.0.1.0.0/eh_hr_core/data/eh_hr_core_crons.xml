<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Vacuum closed rate-limit windows daily. Odoo 19 dropped the
             ir.cron numbercall/doall fields, so they are not set here. -->
        <record id="cron_eh_hr_rate_limit_gc" model="ir.cron">
            <field name="name">EH HR: vacuum rate-limit counters</field>
            <field name="model_id" ref="model_eh_hr_rate_limit"/>
            <field name="state">code</field>
            <field name="code">model._gc_windows()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
