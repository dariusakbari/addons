<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="eh_hr_core.HrStat">
        <div class="o_hrp_stat" t-att-class="'o_hrp_stat--' + props.tone">
            <div class="o_hrp_stat__label" t-out="props.label"/>
            <div class="o_hrp_stat__value">
                <span t-out="props.value"/>
                <span class="o_hrp_stat__unit" t-if="props.unit" t-out="props.unit"/>
            </div>
            <div class="o_hrp_stat__delta" t-att-class="deltaClass" t-if="props.delta !== undefined">
                <span t-out="deltaSign"/> <span t-out="Math.abs(props.delta)"/>
            </div>
        </div>
    </t>
</templates>
