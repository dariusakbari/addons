<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_cs" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.cs</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Construction" name="cs_construction" logo="/cs_controls/static/description/icon.png">
                    <block title="Approvals">
                        <setting string="Change order approval limit" help="Approvals above this amount require a Construction Administrator. 0 disables.">
                            <field name="cs_co_approval_limit"/>
                        </setting>
                    </block>
                    <block title="Reminders">
                        <setting string="RFI reminder lead (days)">
                            <field name="cs_rfi_reminder_days"/>
                        </setting>
                        <setting string="Submittal reminder lead (days)">
                            <field name="cs_submittal_reminder_days"/>
                        </setting>
                    </block>
                    <block title="Billing">
                        <setting string="Default holdback %" help="Withheld on progress billing. Overridable per project.">
                            <field name="cs_holdback_percent"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
