<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_cs_reason_wizard_form" model="ir.ui.view">
        <field name="name">cs.reason.wizard.form</field>
        <field name="model">cs.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reason Required">
                <group>
                    <field name="res_model" invisible="1"/>
                    <field name="res_id" invisible="1"/>
                    <field name="action" readonly="1"/>
                    <field name="target_state" invisible="action != 'override'" groups="cs_core.group_cs_admin"/>
                    <field name="reason" placeholder="Required — recorded permanently in the record's history."/>
                </group>
                <footer>
                    <button name="action_apply" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Back" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
