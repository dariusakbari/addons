<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_cs" model="ir.module.category">
        <field name="name">Construction Suite</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_cs" model="res.groups.privilege">
        <field name="name">Construction Suite</field>
        <field name="sequence">25</field>
        <field name="category_id" ref="module_category_cs"/>
    </record>

    <record id="group_cs_field" model="res.groups">
        <field name="name">Field Employee</field>
        <field name="privilege_id" ref="privilege_cs"/>
    </record>
    <record id="group_cs_foreman" model="res.groups">
        <field name="name">Site Foreman / Superintendent</field>
        <field name="privilege_id" ref="privilege_cs"/>
        <field name="implied_ids" eval="[(4, ref('group_cs_field'))]"/>
    </record>
    <record id="group_cs_estimator" model="res.groups">
        <field name="name">Estimator</field>
        <field name="privilege_id" ref="privilege_cs"/>
        <field name="implied_ids" eval="[(4, ref('group_cs_field'))]"/>
    </record>
    <record id="group_cs_safety" model="res.groups">
        <field name="name">Safety Lead</field>
        <field name="privilege_id" ref="privilege_cs"/>
        <field name="implied_ids" eval="[(4, ref('group_cs_field'))]"/>
    </record>
    <record id="group_cs_coordinator" model="res.groups">
        <field name="name">Project Coordinator</field>
        <field name="privilege_id" ref="privilege_cs"/>
        <field name="implied_ids" eval="[(4, ref('group_cs_field'))]"/>
    </record>
    <record id="group_cs_accounting" model="res.groups">
        <field name="name">Accounting / Project Controls</field>
        <field name="privilege_id" ref="privilege_cs"/>
    </record>
    <record id="group_cs_pm" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="privilege_id" ref="privilege_cs"/>
        <field name="implied_ids" eval="[(4, ref('group_cs_coordinator'))]"/>
    </record>
    <record id="group_cs_executive" model="res.groups">
        <field name="name">Executive (Read-Only)</field>
        <field name="privilege_id" ref="privilege_cs"/>
        <field name="implied_ids" eval="[(4, ref('group_cs_field'))]"/>
    </record>
    <record id="group_cs_admin" model="res.groups">
        <field name="name">Construction Administrator</field>
        <field name="privilege_id" ref="privilege_cs"/>
        <field name="implied_ids" eval="[(4, ref('group_cs_pm')), (4, ref('group_cs_accounting')), (4, ref('group_cs_safety'))]"/>
    </record>
</odoo>
